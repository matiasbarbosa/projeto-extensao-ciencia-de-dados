# Copie para .env e preencha. O .env NÃO vai para o GitHub.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_NAME=Projeto_extensao

# Alternativa sem MariaDB (útil para o professor reproduzir rapidamente):
# DB_URL=sqlite:///data/processed/projeto.sqlite

# Origem dos incidentes usada pelo pipeline: "simulado" ou "real_anonimizado"
FONTE_INCIDENTES=simulado
